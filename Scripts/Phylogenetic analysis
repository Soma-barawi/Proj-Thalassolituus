# Phylogenetic analyses 

# Used Diaiden to extract all 6 genes 

# Align with MAFFT
for gene in nifD nifK nifE nifN nifB
do
    mafft --auto ${gene}.fna > ${gene}_aligned.fna
done

for gene in nifD nifK nifE nifN nifB
do
    mafft --auto ${gene}.faa > ${gene}_aligned.faa
done

# Run IQ-TREE2
for gene in nifH nifD nifK nifE nifN nifB
do
    mkdir -p nif-gene-trees/${gene}-AA-NT-trees/AA-tree
    mkdir -p nif-gene-trees/${gene}-AA-NT-trees/NT-tree

    iqtree3 -s nif-genes-aligned-mafft-auto/${gene}_aligned.faa \
        -m MFP -B 1000 --alrt 1000 -T AUTO \
        --prefix nif-gene-trees/${gene}-AA-NT-trees/AA-tree/${gene}

    iqtree3 -s nif-genes-aligned-mafft-auto/${gene}_aligned.fna \
        -m MFP -B 1000 --alrt 1000 -T AUTO \
        --prefix nif-gene-trees/${gene}-AA-NT-trees/NT-tree/${gene}
done

# Creating nifHDK concatenated alignment
AMAS.py concat \
-i nifH_aligned_fixed.faa \
   nifD_aligned_fixed.faa \
   nifK_aligned_fixed.faa \
-f fasta \
-d aa \
-p nifHDK_partitions.txt \
-t nifHDK_concat.faa

# Creating nifHDKENB concatenated alignment
AMAS.py concat \
-i nifH_aligned_fixed.faa \
   nifD_aligned_fixed.faa \
   nifK_aligned_fixed.faa \
   nifE_aligned_fixed.faa \
   nifN_aligned_fixed.faa \
   nifB_aligned_fixed.faa \
-f fasta \
-d aa \
--part-format raxml \
-p nifHDKENB_partitions.txt \
-t nifHDKENB_concat.faa

iqtree3 \
-s nifHDKENB_concat.faa \
-p nifHDKENB_partitions.txt \
-m MFP+MERGE \
-B 1000 --alrt 1000 \
-T AUTO \
--prefix nifHDKENB_concat_AA


# For ZAMBI conference 
models=(
  "LG+G4"
  "LG+R4"
  "WAG+G4"
  "WAG+R4"
  "GTR20+G4"
  "GTR20+R4"
  "Q.pfam+G4"
  "Q.pfam+R4"
  "NQ.pfam+G4"
  "NQ.pfam+R4"
  "C20"
  "LG4M"
  "LG4X"
)

files=(
  "nifH_aligned_with_outgroup_final.faa"
  "nifD_aligned_with_outgroup_final.faa"
  "nifK_aligned_with_outgroup_final.faa"
  "nifHDK_concat_with_outgroup.faa"
)

for file in "${files[@]}"; do
    gene=$(basename "$file" .faa)

    for model in "${models[@]}"; do
        model_name=$(echo "$model" | sed 's/+/_/g' | sed 's/\./_/g')

        iqtree3 \
            -s "$file" \
            -m "$model" \
            -bb 1000 \
            -alrt 1000 \
            -nt AUTO \
            --prefix "${gene}_${model_name}"
    done
done


# 2. List the TEST MODELS you want to use, one per AU run
MODELS=(
  "C20"
  "GTR20+G4"
  "GTR20+R4"
  "LG+G4"
  "LG+R4"
  "LG4M"
  "LG4X"
  "LG+I+R2"
  "NQ.pfam+G4"
  "NQ.pfam+R4"
  "Q.pfam+G4"
  "Q.pfam+R4"
  "WAG+G4"
  "WAG+R4"
)

# 3. Loop over models and run AU tests one by one
for MODEL in "${MODELS[@]}"; do
  SAFE=${MODEL//+/}   # prefix without plus signs
  echo "Running nifD AU under model: $MODEL"

  iqtree -s nifD_aligned_with_outgroup_final.faa \
         -m "$MODEL" \
         -z nifD_trees_for_AU.treels \
         -n 0 \
         -zb 10000 \
         -zw -au \
         --prefix "nifD_AU_${SAFE}"
done
