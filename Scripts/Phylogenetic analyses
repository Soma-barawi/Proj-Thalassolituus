# The Diaiden pipeline was used to extract the six nif genes

# Align nucleotide and protein sequences with mafft
for gene in nifH nifD nifK nifE nifN nifB; do
    mafft --auto "${gene}.fna" > "${gene}_aligned.fna"
    mafft --auto "${gene}.faa" > "${gene}_aligned.faa"
done

# Make amino acid and nucleotide trees for each gene
for gene in nifH nifD nifK nifE nifN nifB; do
    mkdir -p "nif-gene-trees/${gene}-AA-NT-trees/AA-tree"
    mkdir -p "nif-gene-trees/${gene}-AA-NT-trees/NT-tree"

    iqtree3 -s "nif-genes-aligned-mafft-auto/${gene}_aligned.faa" \
        -m MFP -B 1000 --alrt 1000 -T AUTO \
        --prefix "nif-gene-trees/${gene}-AA-NT-trees/AA-tree/${gene}"

    iqtree3 -s "nif-genes-aligned-mafft-auto/${gene}_aligned.fna" \
        -m MFP -B 1000 --alrt 1000 -T AUTO \
        --prefix "nif-gene-trees/${gene}-AA-NT-trees/NT-tree/${gene}"
done

# Concatenate nifHDK and nifHDKENB protein alignments
AMAS.py concat \
    -i nifH_aligned_fixed.faa nifD_aligned_fixed.faa nifK_aligned_fixed.faa \
    -f fasta -d aa --part-format raxml \
    -p nifHDK_partitions.txt -t nifHDK_concat.faa

AMAS.py concat \
    -i nifH_aligned_fixed.faa nifD_aligned_fixed.faa nifK_aligned_fixed.faa \
    nifE_aligned_fixed.faa nifN_aligned_fixed.faa nifB_aligned_fixed.faa \
    -f fasta -d aa --part-format raxml \
    -p nifHDKENB_partitions.txt -t nifHDKENB_concat.faa

# Run IQ-TREE on the concatenated nifHDKENB alignment
iqtree3 -s nifHDKENB_concat.faa \
    -p nifHDKENB_partitions.txt \
    -m MFP+MERGE -B 1000 --alrt 1000 -T AUTO \
    --prefix nifHDKENB_concat_AA
