# Run Diaiden on the 74 Thalassolituus genomes (identifies nitrogen fixation genes) 

perl Diaiden.pl \
-i /Users/somabarawi/Bioinformatics/diaiden/Diaiden/Thalassolituus_genomes \
-p /Users/somabarawi/Bioinformatics/diaiden/Diaiden \
-c 3 -b 3

# Run BLASTp against SwissProt on Narval

#!/bin/bash
#SBATCH --time=24:00:00
#SBATCH --job-name=blastp
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --account=rrg-rbeiko
#SBATCH --mail-type=FAIL,END
#SBATCH --mail-user=sm871954@dal.ca

module load StdEnv/2023 gcc/12.3
module load blast+/2.14.1

db_path="/home/somab/projects/rrg-rbeiko/somab/Projects/ARETE/Thalassolituus/blast/swissprot_db"
for protein_file in /home/somab/projects/rrg-rbeiko/somab/Projects/ARETE/Thalassolituus/thalassolituus_proteins/*.faa; do
    blastp -query "$protein_file" -db "$db_path" -out "${protein_file%.*}_top_hits.txt" \
        -max_target_seqs 1 -evalue 1e-25 -max_hsps 1 \
        -outfmt '6 qseqid bitscore evalue length qlen qcovs pident sseqid sgi sacc staxid ssciname scomname stitle sseq' \
        -num_threads "$SLURM_CPUS_PER_TASK"
done

# Run InterProScan on Narval

module load StdEnv/2020
module load interproscan/5.64-96.0

proteins="/home/somab/projects/rrg-rbeiko/somab/Projects/ARETE/Thalassolituus/thalassolituus_proteins"
output="/home/somab/projects/rrg-rbeiko/somab/Projects/ARETE/Thalassolituus/interproscan_results"
mkdir -p "$output"

for protein_file in "$proteins"/*.faa; do
    base_name=$(basename "$protein_file" .faa)
    interproscan.sh -i "$protein_file" -f TSV \
        -appl Pfam,SMART,SUPERFAMILY,PRINTS,TIGRFAM,PIRSF \
        -cpu "$SLURM_CPUS_PER_TASK" -goterms -pathways -iprlookup -t p -dp \
        -o "$output/${base_name}_interproscan.tsv"
done

# Run Kofamscan locally

for file in /Users/somabarawi/Bioinformatics/Tools/kofamscan/thalassolituus_proteins/*.faa; do
    filename=$(basename "$file" .faa)
    /Users/somabarawi/Bioinformatics/Tools/kofamscan/kofam_scan-1.3.0/exec_annotation "$file" \
    -f mapper -o "${filename}_kofam.txt" -k /Users/somabarawi/Bioinformatics/Tools/kofamscan/ko_list \
    -p /Users/somabarawi/Bioinformatics/Tools/kofamscan/profiles
done

