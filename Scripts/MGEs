
# hmmsearch against proMGE database using their recombinase HMMs

for f in Proteins/*.faa
do
    name=$(basename "$f" .faa)

    hmmsearch --cpu 8 \
        --domtblout hmmsearch_results/${name}.domtbl \
        --tblout hmmsearch_results/${name}.tbl \
        proMGE_all.hmm \
        "$f" > hmmsearch_results/${name}.txt
done


# geNomad 

for genome in diazotroph_genomes/*.fna; do
    name=$(basename $genome .fna)
    mkdir -p geNomad_output/$name
    apptainer run --bind $(pwd):/app genomad.sif end-to-end \
        /app/$genome \
        /app/geNomad_output/$name \
        /app/genomad_db \
        --cleanup --splits 8
done

# MobileElementFinder 

mkdir -p MGE_output
for genome in Genomes/*.fna; do
    name=$(basename "$genome" .fna)
    mefinder find \
        --contig "$genome" --threads 4 "MGE_output/${name}_mge"
done


# Updated HMMs with proMGE

for aln in *.aln; do
    base=$(basename "$aln" .aln)
    hmmbuild "${base}.hmm" "$aln"
done

cat *.hmm > all_MGEs.hmm
hmmpress all_MGEs.hmm

for prot in *.faa; do
    base=$(basename "$prot" .faa)
    hmmsearch \
      --cpu 4 -E 1e-5 --tblout "HMM_hits/${base}.tbl" all_MGEs.hmm \
      "$prot" \
      > /dev/null
done
