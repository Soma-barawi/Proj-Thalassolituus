# Create a conda environment for snippy 
# https://github.com/tseemann/snippy
conda create -n snippy-env -c bioconda -c conda-forge snippy
conda activate snippy-env

# Create output directory for Snippy results
mkdir -p snippy_out

# Loop through all .fna genome files and run Snippy for each against reference genome
for genome in "/Users/somabarawi/OneDrive - Dalhousie University/Bioinformatics/New_thalassolituus_analysis/thalassolituus_new_genomes/whole_genomes/"*.fna; do
  base=$(basename "$genome" .fna)
  snippy --ref "/Users/somabarawi/OneDrive - Dalhousie University/Bioinformatics/New_thalassolituus_analysis/thalassolituus_new_genomes/whole_genomes/GCF_041222825.fna" \
         --ctgs "$genome" \
         --outdir snippy_out/$base \
         --cpus 4
done

# Generate a core genome alignment from all Snippy output folders using the same reference
snippy-core snippy_out/* \
            --ref "/Users/somabarawi/OneDrive - Dalhousie University/Bioinformatics/New_thalassolituus_analysis/thalassolituus_new_genomes/whole_genomes/GCF_041222825.fna" \
            --prefix core

# Check number of sequences in the alignment (count sequence headers)
grep -c "^>" core.full.aln 

# Count total nucleotide bases in the alignment excluding headers
awk '!/^>/ { count++ } END { print count }' core.full.aln

# Compare two alignment files ignoring header lines and concatenating sequences into a single line
diff <(grep -v "^>" core.full.aln | tr -d '\n') <(grep -v "^>" core.full.singleline.aln)

# Already have conda environment for Gubbins 
# conda activate gubbins_env 
# https://github.com/nickjcroucher/gubbins

# Run alignment checker on the single-line alignment file and save output prefix
gubbins_alignment_checker.py --aln core.full.singleline.aln --out core_alignment_checked

# Rename single-line alignment to the cleaned alignment filename expected by Gubbins
mv core.full.singleline.aln clean.full.aln 

# Run Gubbins recombination detection with filtering for sequences with >99.9% missing data
run_gubbins.py --filter-percentage 99.9 clean.full.aln

# Run Gubbins again with specific parameters: output prefix, threads, tree builders, and input alignment
run_gubbins.py --filter-percentage 99.9 \
  --prefix gubbins_output/thalasso \
  --threads 4 \
  --first-tree-builder fasttree \
  --tree-builder raxml \
  clean.full.aln

# Copy the SNP sites alignment generated by Gubbins for manual use
cp clean.full.aln clean.full.iteration_1.tre.snp_sites.aln 

# Remove RAxML files from iteration 2 to prepare for rerun
rm RAxML_*clean.full.iteration_2 

# Manually run RAxML to build iteration 2 phylogenetic tree using SNP sites alignment and iteration 1 tree
raxmlHPC-PTHREADS-SSE3 -T 4 -safe -m GTRGAMMA -p 4734 -f d \
  -s clean.full.iteration_1.tre.snp_sites.aln \
  -n clean.full.iteration_2 \
  -t clean.full.iteration_1.tre

# Resume gubbins with iteration 2 complete 
run_gubbins.py --threads 4 --resume clean.full.iteration_2.tre clean.full.aln

