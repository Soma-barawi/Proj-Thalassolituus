# species tree file is named "Species_tree_pruned.tree"
# all nif gene trees are unrooted

# with -unrooted option, rspr assumes the first tree (reference) is rooted, and then tests all possible rootings
# of the unrooted gene tree
# It reports the best rooting, i.e. the rooting that minimizes the rSPR distance to the species tree

# species tree vs all nif genes 
for gene in trees/*.tree; do          # iterate through all tree files
  if [[ $gene != *"Species_tree_pruned.tree" ]]; then   # skip species itself
    echo "Comparing Species vs $(basename $gene) [unrooted]"  # label
    cat trees/Species_tree_pruned.tree $gene | ./rspr -unrooted  # run rspr
  fi
done

# -support x     Collapse bipartitions with less than x support
for gene in trees/*.tree; do          # iterate through all tree files
  if [[ $gene != *"Species_tree_pruned.tree" ]]; then   # skip species itself
    echo "Comparing Species vs $(basename $gene) [unrooted, support ≥70]"  # label
    cat trees/Species_tree_pruned.tree $gene | ./rspr -unrooted -support 70  # run rspr with cutoff
  fi
done

# All trees, compared against each other 
echo "Pairwise matrix"
cat trees/*.tree | ./rspr -unrooted -pairwise -no-symmetric-pairwise

echo "Total distance Species vs all genes"
cat trees/*.tree | ./rspr -unrooted -total


# to see which one is the 'moving' taxa 
for gene in trees/*.tree; do
  if [[ $gene != *"Species_tree_pruned.tree" ]]; then
    echo "=== $(basename $gene) ==="
    cat trees/Species_tree_pruned.tree "$gene" | ./rspr -unrooted -support 70 |
      grep "^F[12]:" |
      sed 's/^F[12]: //' |          # remove F1/F2 label
      awk -F')' '{print $NF}' |    # get stuff after the last closing paren
      sed 's/^ *//; s/ p$//'       # trim spaces and drop trailing "p"
    echo
  fi
done

