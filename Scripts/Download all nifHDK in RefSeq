#!/usr/bin/env python3
from Bio import Entrez, SeqIO
import time

genes = {
    "nifH": (250, 350),
    "nifD": (450, 550),
    "nifK": (450, 550),
}

# Taxa to search
taxa = ["bacteria", "archaea"]

def fetch_proteins(gene, org, min_len, max_len, retmax=20000, outdir="."):
    query = f'{gene}[Gene Name] AND {org}[Organism] AND srcdb_refseq[PROP] NOT partial[Title]'
    print(f"\nSearching: {gene} in {org}")
    handle = Entrez.esearch(db="protein", term=query, retmax=retmax)
    record = Entrez.read(handle)
    ids = record["IdList"]
    print(f"  Found {len(ids)} hits")

    if not ids:
        return

    batch_size = 200
    out_file = f"{outdir}/{gene}_{org}_refseq.faa"
    with open(out_file, "w") as out:
        for start in range(0, len(ids), batch_size):
            end = min(len(ids), start + batch_size)
            chunk = ids[start:end]
            efetch_handle = Entrez.efetch(db="protein", id=",".join(chunk),
                                         rettype="fasta", retmode="text")
            records = list(SeqIO.parse(efetch_handle, "fasta"))
            efetch_handle.close()
            # Filter by length
            filtered = [rec for rec in records if min_len <= len(rec.seq) <= max_len]
            SeqIO.write(filtered, out, "fasta")
            print(f"  Wrote {len(filtered)} seqs from {start}–{end}")
            time.sleep(0.34)  # be nice to NCBI

    print(f"  Done: {out_file}")

if __name__ == "__main__":
    for gene, (min_len, max_len) in genes.items():
        for org in taxa:
            fetch_proteins(gene, org, min_len, max_len)
