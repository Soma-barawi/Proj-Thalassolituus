Using anvi'o workflow for the Diazotrophs (6 genomes) 

#First, fix the contig names 

anvi-script-reformat-fasta Thalassoltuus_oleivorans_SRR3933287.fna -o Fixed-oleivorans-SRR3933287.fna --simplify-names --report-file rename-SRR3933287-report-txt

#Then, create a contigs database for each of them because that's what anvi'o needs as input. 

anvi-gen-contigs-database -f Cand_thalassolituus_haligoni.fna --project-name Haligoni_BB40 -o Haligoni_BB40.db

# can also use a for loop, for all the genomes in the directory
for fasta in *.fna
do
    name=$(basename $fasta .fna)
    anvi-gen-contigs-database -f $fasta --project-name $name -o ${name}.db -T 8 --force-overwrite
done


for db in *.db; do         
    anvi-run-ncbi-cogs -c $db -T 8 --cog-data-dir /Users/somabarawi/miniconda3/envs/anvio-8/lib/python3.10/site-packages/anvio/data/misc/COG
done

for db in *.db; do         
    anvi-run-scg-taxonomy -c $db -T 8
done

for db in *.db; do                                                            
    anvi-run-kegg-kofams -c $db -T 8                                                                               
done


anvi-run-ncbi-cogs
anvi-run-HMMs
anvi-run-kegg-kofams
anvi-run-pfams
anvi-run-scg-taxonomy
anvi-run-trna-taxonomy

anvi-estimate-metabolism
anvi-compute-metabolic-enrichment
anvi-compute-genome-similarity
anvi-gen-genomes-storage -e external_genomes.txt -o GENOMES.db
anvi-estimate-scg-taxonomy

anvi-script-gen-function-matrix-across-genomes \
    -e external_genomes.txt \
    --annotation-source COG20_FUNCTION \
    --aggregate-using-all-hits \
    --also-report-accession-ids \
    --min-occurrence 2 \
    -O COG-functional_matrix




