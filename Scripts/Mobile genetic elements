# Search protein files against the proMGE recombinase HMMs
mkdir -p hmmsearch_results

for protein in Proteins/*.faa; do
    name=$(basename "$protein" .faa)
    hmmsearch --cpu 8 \
        --domtblout "hmmsearch_results/${name}.domtbl" \
        --tblout "hmmsearch_results/${name}.tbl" proMGE_all.hmm "$protein" > "hmmsearch_results/${name}.txt"
done

# Run geNomad on the diazotroph genomes
for genome in diazotroph_genomes/*.fna; do
    name=$(basename "$genome" .fna)
    mkdir -p "geNomad_output/$name"

    apptainer run --bind "$(pwd):/app" genomad.sif end-to-end \
        "/app/$genome" "/app/geNomad_output/$name" /app/genomad_db \
        --cleanup --splits 8
done

# Run MobileElementFinder
mkdir -p MGE_output

for genome in Genomes/*.fna; do
    name=$(basename "$genome" .fna)
    mefinder find --contig "$genome" --threads 4 "MGE_output/${name}_mge"
done


# Build updated HMMs using the proMGE alignments
mkdir -p hmm_profiles HMM_hits

for alignment in *.aln; do
    name=$(basename "$alignment" .aln)
    hmmbuild "hmm_profiles/${name}.hmm" "$alignment"
done

cat hmm_profiles/*.hmm > all_MGEs.hmm
hmmpress -f all_MGEs.hmm

for protein in *.faa; do
    name=$(basename "$protein" .faa)
    hmmsearch --cpu 4 -E 1e-5 \
        --tblout "HMM_hits/${name}.tbl" all_MGEs.hmm "$protein" > /dev/null
done
