# Example of boxplot from https://www.appsilon.com/post/ggplot2-boxplots

# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)

setwd(dir = "/Users/somabarawi/Desktop/")
data <- read_csv("metadata.csv", show_col_types = FALSE)

# Convert columns to numeric (just in case)
data$Completeness <- as.numeric(data$Completeness)
data$Contamination <- as.numeric(data$Contamination)
data$Genome_Size <- as.numeric(data$Genome_Size)

# Filter out NAs 
data <- data %>%
  filter(!is.na(Completeness), !is.na(Contamination), !is.na(Genome_Size))

# Long format
data_long <- data %>%
  pivot_longer(
    cols = c(Completeness, Contamination, Genome_Size),
    names_to = "Metric",
    values_to = "Value"
  )

# Factor labels for facets
data_long$Metric <- factor(data_long$Metric,
                           levels = c("Completeness", "Contamination", "Genome_Size"),
                           labels = c("Completeness (%)", "Contamination (%)", "Genome Size (bp)")
)

# Generate boxplots
boxplot <- ggplot(data_long, aes(x = Type, y = Value, fill = Type)) +
  geom_boxplot(alpha = 0.7, outlier.shape = 21, outlier.size = 1.5, outlier.fill = "black") +
  stat_summary(
    fun = mean, geom = "point", shape = 20, size = 3, fill = "white", color = "red"
  ) +
  stat_summary(
    fun.min = function(x) mean(x) - sd(x),
    fun.max = function(x) mean(x) + sd(x),
    geom = "errorbar",
    color = "red",
    width = 0.3,
    linewidth = 0.6
  ) +
  facet_wrap(~Metric, scales = "free_y", ncol = 3) +
  scale_fill_manual(values = c("Isolate" = "white", "MAG" = "white")) +
  theme_bw() +
  theme(
    legend.position = "none",
    plot.title = element_text(hjust = 0.5, size = 12),
    strip.background = element_rect(fill = "lightgrey"),
    strip.text = element_text(size = 12),
    axis.title.x = element_text(size = 12),
    axis.title.y = element_blank(),
    axis.text.x = element_text(size = 12),
    axis.text.y = element_text(size = 12),
    plot.caption = element_text(hjust = 0, face = "italic", size = 12)
  ) +
  labs(
    x = "Genome Type",
    caption = paste0("n(Isolate) = ", sum(data$Type == "Isolate"), ", n(MAG) = ", sum(data$Type == "MAG"))
  )

ggsave("Genomes-quality-boxplots.png",
       boxplot,
       width = 10,
       height = 6.5,
       units = "in",
       dpi = 600)


