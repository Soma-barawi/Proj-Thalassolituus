library(tidyverse)
library(ggplot2)
library(rnaturalearth)
library(rnaturalearthdata)
library(sf)
library(openxlsx)

# Set working directory
base_dir <- "/Users/somabarawi/OneDrive - Dalhousie University/Bioinformatics/Chapter-1-Analyses/TARA distribution map"
setwd(base_dir)

# Clade folders and colours
clade_info <- tribble(
  ~clade_name, ~folder_name, ~color,
  "Thalassolituus haligoni BB40 (Clade 1)", "Clade 1 - Haligoni", "#f4a582",
  "HBD_Gamma_08 (Clade 1)", "Clade 1 - HBD_Gamma08", "#f4a582",
  "HBD_Gamma_11 (Clade 1)", "Clade 1 - HBD_Gamma11", "#f4a582",
  "Parathalassolituus penaei G-43 (Clade 1)", "Clade 1 - Parathalassolituus", "#f4a582",
  "HBD_Gamma_06 (Clade 2)", "Clade 2 - HBD_Gamma06", "#92c5de",
  "HBD_Gamma_09 (Clade 2)", "Clade 2 - HBD_Gamma09", "#92c5de",
  "HBD_Gamma_04 (Clade 3)", "Clade 3 - HBD_Gamma04", "#0571b0",
  "Thalassolituus sp. MAG485 (Clade 4)", "Clade 4 - MAG485", "#ca0020",
  "Thalassolituus oleivorans SRR3933287 (Clade 4)", "Clade 4 - Oleivorans", "#ca0020"
)

color_map_exploratory <- setNames(clade_info$color, clade_info$clade_name)
target_length <- 288
target_identity <- 100

# Load environmental metadata
env_data <- read_tsv("environmental_parameters.csv", show_col_types = FALSE) %>%
  rename_with(~sub("^#", "", .x))

env_subset <- env_data %>%
  select(sample_ID, latitude, longitude, depth)

master_dataset <- tibble()

# Process each clade folder
for (i in seq_len(nrow(clade_info))) {
  current_clade <- clade_info$clade_name[i]
  current_folder <- clade_info$folder_name[i]
  
  aln_file <- list.files(current_folder, pattern = "aln_result\\.tsv$", recursive = TRUE, full.names = TRUE)[1]
  abund_file <- list.files(current_folder, pattern = "abundance_matrix\\.csv$", recursive = TRUE, full.names = TRUE)[1]
  
  if (is.na(aln_file) || is.na(abund_file)) {
    warning("Files not found for: ", current_clade)
    next
  }
  
  aln_data <- read_tsv(aln_file, comment = "#", show_col_types = FALSE)
  id_col <- intersect(colnames(aln_data), c("pct_identity", "pident", "identity"))[1]
  
  if (is.na(id_col)) {
    warning("Identity column not found for: ", current_clade)
    next
  }
  
  valid_alignments <- aln_data %>%
    filter(.data[[id_col]] >= target_identity, aln_length >= target_length) %>%
    transmute(subject_id, pct_identity = .data[[id_col]], aln_length) %>%
    distinct()
  
  if (nrow(valid_alignments) > 0) {
    abund_data <- read_tsv(abund_file, skip = 1, show_col_types = FALSE) %>%
      rename_with(~sub("^#", "", .x))
    
    long_abundance <- abund_data %>%
      filter(Gene_ID %in% valid_alignments$subject_id) %>%
      pivot_longer(cols = -c(Gene_ID, taxonomy), names_to = "sample_ID",
                   values_to = "normalized_abundance") %>%
      filter(normalized_abundance > 0) %>%
      left_join(valid_alignments, by = c("Gene_ID" = "subject_id")) %>%
      mutate(Clade = current_clade)
    
    master_dataset <- bind_rows(master_dataset, long_abundance)
  }
}

# Add coordinates and depths
merged_data <- master_dataset %>%
  left_join(env_subset, by = "sample_ID") %>%
  filter(!is.na(latitude), !is.na(longitude), !is.na(depth))

write.xlsx(merged_data, "merged_data.xlsx", overwrite = TRUE)

# Remove duplicate hits
clean_data <- merged_data %>%
  distinct(Gene_ID, sample_ID, .keep_all = TRUE) %>%
  mutate(Clade = str_trim(Clade))

write.xlsx(clean_data, "cleaned_data.xlsx", overwrite = TRUE)

# Aggregate abundance by location
aggregated_map_data <- clean_data %>%
  group_by(longitude, latitude, depth, Clade) %>%
  summarise(total_abundance = sum(normalized_abundance), .groups = "drop")

write.xlsx(aggregated_map_data, "aggregated_map_data.xlsx", overwrite = TRUE)

# Set depth order
depth_order <- c("SRF", "MIX", "DCM", "MES", "FSW", "ZZZ")
existing_depths <- depth_order[depth_order %in% unique(clean_data$depth)]

clean_data <- clean_data %>%
  mutate(depth = factor(depth, levels = existing_depths))

aggregated_map_data <- aggregated_map_data %>%
  mutate(depth = factor(depth, levels = existing_depths))

# Check that the clade names match the colour names
unmatched_clades <- setdiff(unique(clean_data$Clade), names(color_map_exploratory))

if (length(unmatched_clades) > 0) {
  warning("No colour found for: ", paste(unmatched_clades, collapse = ", "))
}

# Load world map
world <- ne_countries(scale = "medium", returnclass = "sf")

# Labels inside each map
depth_labels <- clean_data %>%
  distinct(depth) %>%
  mutate(longitude = -174, latitude = -56)

# Make map
final_plot <- ggplot() +
  geom_sf(data = world, fill = "#777777", color = NA) +
  geom_point(data = clean_data,
             aes(x = longitude, y = latitude, size = normalized_abundance, fill = Clade),
             shape = 21, color = "grey20", stroke = 0.2, alpha = 0.9) +
  geom_text(data = depth_labels, aes(x = longitude, y = latitude, label = depth),
            inherit.aes = FALSE, family = "Arial", size = 4.2,
            color = "grey20", hjust = 0, vjust = 0) +
  facet_wrap(~depth, ncol = 2) +
  scale_fill_manual(values = color_map_exploratory, drop = FALSE) +
  scale_size_continuous(range = c(2, 10), labels = scales::label_scientific()) +
  coord_sf(xlim = c(-180, 180), ylim = c(-60, 80), expand = FALSE) +
  labs(size = "Abundance", fill = "Clade") +
  guides(
    fill = guide_legend(order = 1, override.aes = list(size = 4, alpha = 1)),
    size = guide_legend(order = 2, override.aes = list(fill = "grey55", alpha = 1))
  ) +
  theme_void(base_size = 12, base_family = "Arial") +
  theme(
    text = element_text(family = "Arial", color = "grey20"),
    panel.background = element_rect(fill = "#F1F1F1", color = NA),
    panel.border = element_rect(fill = NA, color = "grey80", linewidth = 0.35),
    panel.spacing = grid::unit(3, "mm"),
    strip.text = element_blank(),
    strip.background = element_blank(),
    legend.position = "right",
    legend.title = element_text(size = 12),
    legend.text = element_text(size = 12),
    legend.margin = margin(3, 5, 3, 5),
    aspect.ratio = 0.48,
    plot.margin = margin(4, 4, 4, 4)
  )

final_plot

# Make supplementary table
env_data_clean <- env_data %>%
  rename_with(~str_remove(.x, " \\(.*\\)")) %>%
  select(!matches("\\.\\.\\.")) %>%
  distinct(sample_ID, .keep_all = TRUE)

supplementary_table <- clean_data %>%
  left_join(env_data_clean, by = "sample_ID")

write.xlsx(supplementary_table, "Distribution-map-metadata.xlsx", overwrite = TRUE)
