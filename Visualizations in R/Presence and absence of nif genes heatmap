#to change the NA colors on the color scale to either black or white 
heatmap_matrix <- blastp_data %>%
  select(Genomes, Gene, Pident) %>%
  pivot_wider(
    names_from = Genomes, 
    values_from = Pident, 
    values_fn = mean,
    values_fill = list(Pident = NA)  # changed from 0 to NA
  ) %>%
  column_to_rownames(var = "Gene") %>%
  as.matrix()
# value range excluding NAs
value_range <- range(heatmap_matrix, na.rm = TRUE)

p <- pheatmap(
  heatmap_matrix, 
  color = viridis(100, option = "plasma"),
  na_col = "white",  # Now works as TRUE missing values exist
  breaks = seq(value_range[1], value_range[2], length.out = 100),
  cluster_rows = FALSE,
  cluster_cols = FALSE,
  annotation_row = pathway_annotations,
  annotation_colors = ann_colors,
  border_color = "grey",
  fontsize = 9,
  fontsize_row = 11,
  fontsize_col = 9,
  angle_col = 45,
  main = "Extracted Nif genes using BLASTp based on percent identity",
  margins = c(10, 10),
  cellwidth = 12,
  cellheight = 12
)

ggsave("nif_updated_heatmap.png", p, width = 12, height = 12, units = "in", dpi = 500)



